# Financial Modeling Prep API key — REQUIRED for live data on Vercel.
#
# Yahoo Finance (the keyless fallback) works locally but is blocked from
# datacenter IPs like Vercel's, so production needs this key.
#
# Get a free key (no credit card): https://site.financialmodelingprep.com/developer
# Then in Vercel: Settings → Environment Variables → add FMP_API_KEY, and redeploy.
FMP_API_KEY=
