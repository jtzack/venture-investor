# ── Data provider keys (the app uses the first one that's set) ──────────────
#
# 1) FINNHUB (recommended) — free tier covers US small-caps, works on Vercel.
#    Get a free key (no credit card): https://finnhub.io/register
FINNHUB_API_KEY=

# 2) FMP (optional) — works on Vercel, but its FREE plan excludes small-caps
#    (returns HTTP 402 for them). Only useful on a paid plan.
#    https://site.financialmodelingprep.com/developer
FMP_API_KEY=

# If neither is set, the app falls back to keyless Yahoo Finance, which works
# locally but is blocked from datacenter IPs like Vercel's.
